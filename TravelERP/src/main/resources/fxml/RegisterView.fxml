<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.travelagency.controller.RegisterController"
            prefWidth="1000" prefHeight="620">
    <VBox spacing="12" layoutX="320" layoutY="120" AnchorPane.leftAnchor="320" AnchorPane.rightAnchor="320"
          AnchorPane.topAnchor="120" AnchorPane.bottomAnchor="120" alignment="CENTER">
        <Label text="Create New Account" style="-fx-font-size: 28; -fx-text-fill: #2c3e50;"/>
        <TextField fx:id="usernameField" promptText="Username" prefWidth="360"/>
        <PasswordField fx:id="passwordField" promptText="Password" prefWidth="360"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefWidth="360"/>
        <ComboBox fx:id="roleComboBox" promptText="Select Role" prefWidth="360"/>
        <Button fx:id="registerButton" text="Register" prefWidth="360" prefHeight="42"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14;"/>
        <Button fx:id="backToLoginButton" text="Back to Login" prefWidth="360" prefHeight="42"
                style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 14;"/>
        <Label fx:id="messageLabel" text="" style="-fx-font-size: 12; -fx-text-fill: #e74c3c;" wrapText="true" prefWidth="360"/>
    </VBox>
</AnchorPane>
